      "targets": [
        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT log_date AS \"Fecha\", extension AS \"Extensión\", user_id::text AS \"Usuario\", ip_address AS \"IP\", LEFT(message, 120) AS \"Evento\" FROM joom_action_logs UNION ALL SELECT NOW() AS \"Fecha\", 'Sin actividad' AS \"Extensión\", '-' AS \"Usuario\", '-' AS \"IP\", 'Aún no hay eventos registrados en Joomla.' AS \"Evento\" WHERE NOT EXISTS (SELECT 1 FROM joom_action_logs) ORDER BY \"Fecha\" DESC LIMIT 20;",
          "refId": "A"
        }
