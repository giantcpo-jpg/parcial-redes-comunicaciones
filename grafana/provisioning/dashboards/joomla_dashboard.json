    {
      "id": 12,
      "title": "Actividad Joomla en el tiempo",
      "description": "Eventos almacenados en joom_action_logs durante el intervalo seleccionado.",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "postgres",
        "uid": "PostgreSQL"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Eventos",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH buckets AS (SELECT generate_series(to_timestamp($__unixEpochFrom()), to_timestamp($__unixEpochTo()), interval '5 minutes') AS time) SELECT b.time AS time, COUNT(l.id) AS \"Eventos\" FROM buckets b LEFT JOIN joom_action_logs l ON l.log_date >= b.time AND l.log_date < b.time + interval '5 minutes' GROUP BY b.time ORDER BY b.time;",
          "refId": "A"
        }
      ]
    },
